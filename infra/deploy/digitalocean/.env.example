# Copy to `.env` on the SERVER (cp .env.example .env) and fill it in. `.env` is git-ignored: never commit or paste it.
# Optional lines stay commented out: an EMPTY value is rejected by the API, a missing line is fine.

# --- required ---
# ":80" = plain HTTP on the server IP (private tests with FAKE data only). Later put the real domain, e.g. yondo.example,
# add its DNS A record to this server's IP, and run `docker compose up -d`: HTTPS appears by itself.
DOMAIN=:80
# Generate each with:  openssl rand -hex 24   (letters and digits only: it goes into a URL)
POSTGRES_PASSWORD=
YONDO_AUTH_OTP_PEPPER=

# --- login codes via Telegram (without it real login answers 503 "not connected": there is no on-screen code in production) ---
# YONDO_TELEGRAM_GATEWAY_TOKEN=

# --- payments via TezCheck (needs the domain: its webhook is https://<domain>/api/v1/payments/webhook) ---
# YONDO_TEZCHECK_TOKEN=
# YONDO_TEZCHECK_CASH_DESK_CODE=
# YONDO_TEZCHECK_WEBHOOK_SECRET=
# Platform fee in basis points (500 = 5 %). Owner decision: unset means payment answers 503 "not configured".
# YONDO_PLATFORM_FEE_BPS=
