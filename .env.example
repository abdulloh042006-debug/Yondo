YONDO_ENVIRONMENT=development
YONDO_DEBUG=false
YONDO_LOG_LEVEL=INFO
YONDO_DATABASE_URL=postgresql+psycopg://yondo:yondo@localhost:5432/yondo
YONDO_REDIS_URL=redis://localhost:6379/0
YONDO_STORAGE_ENDPOINT=http://localhost:9000
YONDO_STORAGE_BUCKET=yondo-local
# Local development only; never reuse these credentials outside Compose.
YONDO_STORAGE_ACCESS_KEY=yondo
YONDO_STORAGE_SECRET_KEY=change-me-in-local-env
YONDO_STORAGE_REGION=us-east-1
YONDO_FCM_PROJECT_ID=

# Leave unset until the platform fee policy is approved. Example: 500 = 5%.
# YONDO_PLATFORM_FEE_BPS=500
# Local-only OTP hashing key. Set a random value of at least 32 characters in production.
YONDO_AUTH_OTP_PEPPER=development-only-change-me
YONDO_AUTH_ACCESS_TOKEN_LIFETIME_SECONDS=900
YONDO_AUTH_REFRESH_TOKEN_LIFETIME_SECONDS=2592000
# Zero disables the provider-wide rate-limit hook.
YONDO_AUTH_OTP_PROVIDER_RATE_LIMIT_PER_MINUTE=0
# Telegram Gateway (https://core.telegram.org/gateway) delivers the login code to the user's Telegram.
# Token from https://gateway.telegram.org/account/api: set it ONLY in the host's environment
# (Render -> Environment), never in a committed file. Empty = not configured (development shows the
# code on screen; staging/production answer 503). While set, it is used in EVERY environment and sends
# real, paid messages (free to your own number). The public demo ignores it. Setup: docs/otp-telegram-gateway.md
YONDO_TELEGRAM_GATEWAY_TOKEN=
# Optional; keep commented unless you know why (an empty value is invalid, the base URL must be https).
# YONDO_TELEGRAM_GATEWAY_BASE_URL=https://gatewayapi.telegram.org
# YONDO_TELEGRAM_GATEWAY_TIMEOUT_SECONDS=10

# Phase 6 technical limits; price/currency/duration policy remains configurable.
YONDO_COMPANION_MAX_PHOTOS=20
YONDO_COMPANION_PHOTO_MAX_BYTES=10485760
YONDO_COMPANION_PHOTO_MAX_PIXELS=25000000
# Tuple settings are JSON arrays, e.g. ["UZS"] or [30,60].
# YONDO_COMPANION_ALLOWED_CURRENCIES=[]
# YONDO_COMPANION_PRICE_MIN_MINOR=0
# YONDO_COMPANION_PRICE_MAX_MINOR=
# YONDO_COMPANION_ALLOWED_UNIT_MINUTES=[]

# Cancellation tracking and booking abuse guards (docs/cancellation-policy.md).
# Every number is an unapproved PLACEHOLDER until the owner approves the policy; 0 = off for thresholds/limits.
# YONDO_CANCELLATION_TRACKING_ENABLED=true
# YONDO_CANCELLATION_LAST_MINUTE_HOURS=24
# YONDO_CANCELLATION_WINDOW_DAYS=30
# YONDO_CANCELLATION_COUNT_PENDING_REQUESTS=false
# YONDO_CANCELLATION_WARNING_THRESHOLD=3
# YONDO_CANCELLATION_REVIEW_THRESHOLD=5
# YONDO_CANCELLATION_LAST_MINUTE_REVIEW_THRESHOLD=3
# YONDO_CANCELLATION_NO_SHOW_REVIEW_THRESHOLD=2
# YONDO_CANCELLATION_EMERGENCY_CLAIM_REVIEW_THRESHOLD=3
# YONDO_BOOKING_RESTRICTION_DEFAULT_DAYS=7
# YONDO_BOOKING_RESTRICTION_MAX_DAYS=30
# YONDO_BOOKING_REQUESTS_PER_HOUR_LIMIT=20
# YONDO_BOOKING_OPEN_REQUESTS_LIMIT=10
# YONDO_BOOKING_OPEN_REQUESTS_PER_COMPANION_LIMIT=3
