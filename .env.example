YONDO_ENVIRONMENT=development
YONDO_DEBUG=false
YONDO_LOG_LEVEL=INFO
YONDO_DATABASE_URL=postgresql+psycopg://yondo:yondo@localhost:5432/yondo
YONDO_REDIS_URL=redis://localhost:6379/0

# Object storage: disabled | s3 | local (local = development-only filesystem adapter).
YONDO_STORAGE_BACKEND=s3
YONDO_STORAGE_ENDPOINT=http://localhost:9000
# Public origin used in presigned download URLs (defaults to the endpoint).
YONDO_STORAGE_PUBLIC_ENDPOINT=
YONDO_STORAGE_BUCKET=yondo-local
# Local development only; never reuse these credentials outside Compose.
YONDO_STORAGE_ACCESS_KEY=yondo
YONDO_STORAGE_SECRET_KEY=change-me-in-local-env
YONDO_STORAGE_REGION=us-east-1
YONDO_STORAGE_PATH_STYLE=true
# YONDO_STORAGE_LOCAL_ROOT=.storage
# YONDO_STORAGE_LOCAL_PUBLIC_URL=http://localhost:8000/api/v1/storage/local

# Browser origins allowed to call the API (JSON array), e.g. the Expo web preview.
YONDO_CORS_ALLOW_ORIGINS=["http://localhost:8081","http://localhost:5173"]

# Local-only OTP hashing key. Set a random value of at least 32 characters in production.
YONDO_AUTH_OTP_PEPPER=development-only-change-me
YONDO_AUTH_ACCESS_TOKEN_LIFETIME_SECONDS=900
YONDO_AUTH_REFRESH_TOKEN_LIFETIME_SECONDS=2592000
# Zero disables the provider-wide rate-limit hook.
YONDO_AUTH_OTP_PROVIDER_RATE_LIMIT_PER_MINUTE=0

# Phase 6 technical limits; price/currency/duration policy remains configurable.
YONDO_COMPANION_MAX_PHOTOS=20
YONDO_COMPANION_PHOTO_MAX_BYTES=10485760
YONDO_COMPANION_PHOTO_MAX_PIXELS=25000000
# Tuple settings are JSON arrays, e.g. ["UZS"] or [30,60].
# YONDO_COMPANION_ALLOWED_CURRENCIES=[]
# YONDO_COMPANION_PRICE_MIN_MINOR=0
# YONDO_COMPANION_PRICE_MAX_MINOR=
# YONDO_COMPANION_ALLOWED_UNIT_MINUTES=[]

# ---- PLACEHOLDER business policy (see docs/business-policies.md; pending approval) ----
YONDO_ACCOUNT_MIN_AGE=18
YONDO_BOOKING_PLATFORM_FEE_BPS=1000
YONDO_BOOKING_COMPANION_COMMISSION_BPS=0
YONDO_BOOKING_FREE_CANCELLATION_HOURS=24
YONDO_BOOKING_LATE_CANCELLATION_REFUND_BPS=5000
YONDO_BOOKING_MIN_LEAD_MINUTES=60
YONDO_BOOKING_MAX_HORIZON_DAYS=60
YONDO_BOOKING_MAX_DURATION_MINUTES=480
YONDO_BOOKING_REQUEST_TTL_MINUTES=120
YONDO_BOOKING_PAYMENT_WINDOW_MINUTES=60
YONDO_MEETING_CHECKIN_WINDOW_MINUTES=30
YONDO_MEETING_NO_SHOW_GRACE_MINUTES=15
YONDO_MEETING_AUTO_COMPLETE_HOURS=2
YONDO_PAYOUT_RELEASE_DELAY_HOURS=24
YONDO_REVIEW_WINDOW_DAYS=14
YONDO_DISPUTE_WINDOW_DAYS=7
YONDO_GIFT_PLATFORM_FEE_BPS=0
YONDO_VENDOR_COMMISSION_BPS=0

# Payments: auto = sandbox locally, disabled in staging/production until a provider is chosen.
YONDO_PAYMENT_PROVIDER=auto
YONDO_PAYMENT_WEBHOOK_SECRET=development-only-webhook-secret
YONDO_PAYMENT_CHECKOUT_BASE_URL=http://localhost:8000/api/v1/payments/sandbox

# Push: log | fcm | disabled. FCM needs a Firebase service-account JSON file (never commit it).
YONDO_PUSH_PROVIDER=log
YONDO_FCM_PROJECT_ID=
# YONDO_FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
YONDO_WORKER_INTERVAL_SECONDS=30
